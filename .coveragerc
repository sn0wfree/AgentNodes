[run]
branch = True
source = strategy_research
omit =
    # 入口与脚手架
    */__main__.py
    */conftest.py
    # 交互式向导（需要真人输入，单元测试价值低）
    */cli/onboard.py
    # 外部数据源加载器（网络协议客户端，用集成测试而非单元测试验证）
    */core/data_source/akshare_loader.py
    */core/data_source/ifind_loader.py
    */core/data_source/tushare_loader.py

[report]
# 不追求 100%：防御性 except 与类型检查分支无法有意义地覆盖
exclude_lines =
    pragma: no cover
    raise NotImplementedError
    if TYPE_CHECKING:
    if __name__ == .__main__.:
    \.\.\.
    except ImportError:
    @abstractmethod
    # 平台降级路径：明确标注为「不可达则降级」的分支
    pragma: no branch

# 分档说明：全库口径含归档与外部集成，不作为门槛。
# 门槛由 scripts/cov_gate.py 按四档分别断言（见 docs/coverage-90-plan-20261030.md）：
#   A 平台内核 / B 研究域 / C 能力层 / H 研究工具核心（core 下未被前三档认领的剩余）
show_missing = True
skip_covered = False
precision = 1

[html]
directory = tmp/coverage_html
